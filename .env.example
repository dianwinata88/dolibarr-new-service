# Copy to .env.local (local dev) or inject via your orchestrator (deployed envs).
# NEVER commit real secrets — this file only holds placeholders.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-with-a-real-random-secret
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
# "database" is the docker-compose service name
DATABASE_URL="mysql://dolibarr:dolibarr@database:3306/dolibarr_crm?serverVersion=mariadb-11.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app ###
# Comma-separated list of accepted Dolibarr-style API keys.
# Requests authenticate with the DOLAPIKEY header or the api_key query param.
# In a deployed environment this should be replaced by real secrets / an OIDC provider.
DOLIBARR_API_KEYS="change-me"
###< app ###

###> docker-compose ###
SERVER_NAME=:80
HTTP_PORT=80
MARIADB_VERSION=11.4
MARIADB_DATABASE=dolibarr_crm
MARIADB_USER=dolibarr
MARIADB_PASSWORD=dolibarr
MARIADB_ROOT_PASSWORD=root
MARIADB_PORT=3306
###< docker-compose ###
