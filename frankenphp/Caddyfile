{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	# HTTPS is handled by the reverse proxy in front of this service
	auto_https off
}

{$CADDY_EXTRA_CONFIG}

# Defaults to a plain-HTTP catch-all on :80: TLS is terminated by the
# reverse proxy in front of this service (auto_https is off above).
# Set SERVER_NAME to a hostname to restrict the served host.
{$SERVER_NAME::80} {
	log

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
